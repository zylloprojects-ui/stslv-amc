# STSLV AMC backup jobs — settings. TEMPLATE: copy to /etc/stslv-amc/backup.env
# (owner root, group stslv-backup, mode 0640) and fill in. NEVER commit the filled-in file.
# Read by: node dist/ops/cli.js <command> (systemd units stslv-amc-backup-daily / stslv-amc-backup-weekly, and the
# by-hand units stslv-amc-db-backup / stslv-amc-docs-backup) and by /usr/local/sbin/stslv-amc-config-snapshot.
# Schedule (Asia/Kolkata, 18:00): Saturday–Thursday daily = database + documents; Friday = weekly full backup
# (database + documents + VPS configuration); the last Friday of the month = monthly full backup instead.
# Full explanation: docs/BACKUP_AUTOMATION.md.

NODE_ENV=production
# Label in backup names, alerts and logs: lowercase letters, digits, hyphens.
BACKUP_ENVIRONMENT=production

# --- Source database (Neon) --------------------------------------------------------------------------
# Prefer a dedicated READ-ONLY role for backups (deploy/hostinger/sql/backup-role.sql), not the API's owner role.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
PGSSLMODE=verify-full
# Schemas to back up (comma-separated). The application lives in "public".
BACKUP_DB_SCHEMAS=public
# PostgreSQL 17 client tools (must not be older than the Neon server).
PG_DUMP_PATH=/usr/lib/postgresql/17/bin/pg_dump
PG_RESTORE_PATH=/usr/lib/postgresql/17/bin/pg_restore

# --- Encryption --------------------------------------------------------------------------------------
# FULL fingerprint (40 or 64 hex characters) of the backup PUBLIC key imported into GNUPGHOME.
# The private key is NOT on this server (docs/BACKUP_AUTOMATION.md "Keys").
BACKUP_GPG_RECIPIENT=
GNUPGHOME=/var/lib/stslv-amc-backup/gnupg
# GPG_PATH=gpg

# --- Working folders on the VPS (plain data exists here only during a run) ----------------------------
BACKUP_WORK_DIR=/var/lib/stslv-amc-backup/work
BACKUP_STATE_DIR=/var/lib/stslv-amc-backup/state

# --- Off-site destination: GOOGLE DRIVE (approved 2026-11-18) -------------------------------------------
# My Drive / "STS-ELV Backup" / Daily | Weekly | Monthly, through rclone (installed from the rclone .deb, see
# docs/BACKUP_AUTOMATION.md "Google Drive"). Set EITHER this section OR the S3 section below, never both.
# The folder is identified by its Drive ID (the end of its address: drive.google.com/drive/folders/<ID>); before
# every run the job checks that this ID is the one folder named BACKUP_GDRIVE_FOLDER_NAME at the top of My Drive.
BACKUP_GDRIVE_FOLDER_ID=
BACKUP_GDRIVE_FOLDER_NAME=STS-ELV Backup
# rclone's configuration with the OAuth token: owned by stslv-backup, mode 0600, NEVER in GitHub or the app.
# rclone writes the refreshed token back into it, so it lives in the job's writable folder.
BACKUP_RCLONE_CONFIG=/var/lib/stslv-amc-backup/rclone/rclone.conf
BACKUP_RCLONE_REMOTE=stselv-gdrive
BACKUP_RCLONE_PATH=/usr/bin/rclone

# --- Alternative off-site destination: an S3-compatible bucket (leave EMPTY when Google Drive is used) ------
# Not Neon, not the production Supabase project (the job refuses the Supabase project). Examples: Backblaze B2,
# Cloudflare R2, Wasabi, AWS S3. Use a key limited to this one bucket. Turn on bucket versioning and, where
# offered, object lock / retention so a stolen key cannot erase history.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Optional folder inside the bucket, e.g. stslv-amc/production/
BACKUP_S3_PREFIX=stslv-amc/production/
# true where the provider supports conditional writes (If-None-Match: *), so the bucket itself refuses overwrites.
BACKUP_S3_CONDITIONAL_WRITES=false

# --- Retention (off-site) -------------------------------------------------------------------------------
# Recovery points kept, by type (daily / weekly / monthly backups, counted over complete, verified backups):
# database 14 daily, 8 weekly, 12 monthly; configuration 8 weekly (never fewer than 4), 12 monthly.
# Pruning never runs while 7 or fewer complete backups exist. Document copies are never deleted.
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8
BACKUP_RETAIN_MONTHLY=12
BACKUP_PRUNE=true
# Download each uploaded backup again and compare its checksum (recommended).
BACKUP_VERIFY_DOWNLOAD=true

# --- Alerts --------------------------------------------------------------------------------------------
# Chat webhook (Slack / Google Chat / Discord style): one message per failure.
BACKUP_ALERT_WEBHOOK_URL=
# Dead-man's switch URLs (e.g. healthchecks-style), pinged on success and at "<url>/fail" on failure.
# The external service alerts when a ping does not arrive on time, which also catches a job that never ran.
BACKUP_HEARTBEAT_DB_URL=
BACKUP_HEARTBEAT_DOCS_URL=
# Weekly configuration backup (expected every Friday 18:00 IST).
BACKUP_HEARTBEAT_CONFIG_URL=

# --- Document source (read-only use): the same storage settings the API uses --------------------------
SUPABASE_PROJECT_REF=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=
