# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stslv_amc_dev
DB_USER=postgres
DB_PASSWORD=

# Authentication
# Long random value (at least 32 characters) used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid: a number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# Web origins allowed to call the API from a browser (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Sign up and password recovery
# Web address of the application, used in links sent by email.
# Defaults to the first CORS_ORIGIN.
APP_URL=http://localhost:5173
# How outgoing email is handled:
#   none  nothing is sent (default). Password reset links are created but not delivered.
#   log   LOCAL DEVELOPMENT ONLY: the whole message, including the reset link, is
#         printed to the API console. The API refuses to start with this value
#         when NODE_ENV=production.
# No real email provider is configured yet (see docs/AUTH_SIGNUP_AND_RECOVERY.md).
MAIL_TRANSPORT=none
# Minutes a password reset link stays usable (5 to 1440).
PASSWORD_RESET_EXPIRES_MINUTES=30
# Requests one network address may make to the public sign-up and
# password-recovery routes per 15 minutes.
PUBLIC_AUTH_RATE_LIMIT=10
