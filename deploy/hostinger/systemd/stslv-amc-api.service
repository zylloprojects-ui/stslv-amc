# STSLV AMC API — systemd unit. TEMPLATE: NOT YET DEPLOYED.
# Install as /etc/systemd/system/stslv-amc-api.service, then:
#   systemctl daemon-reload && systemctl enable --now stslv-amc-api
# Restart after a release:   systemctl restart stslv-amc-api
# Logs:                      journalctl -u stslv-amc-api -f
#
# Runs as the unprivileged user "stslv" (no shell, no sudo). Secrets come from
# /etc/stslv-amc/api.env (owner root, group stslv, mode 0640), never from this file or the repository.
# Node.js is expected at /usr/bin/node (Node 24, as on Render). Adjust ExecStart if installed elsewhere.

[Unit]
Description=STSLV AMC API (Node.js) - see docs/HOSTINGER_VPS.md in the repository
After=network-online.target
Wants=network-online.target
# Stop restarting after 5 failures in 5 minutes; the monitor reports the failed unit.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=stslv
Group=stslv
WorkingDirectory=/opt/stslv-amc/api/current
EnvironmentFile=/etc/stslv-amc/api.env
Environment=NODE_ENV=production
# Same order as Render: pending migrations first (each in its own transaction; a failure stops the start
# and the previous release keeps the database untouched), then the server.
ExecStartPre=/usr/bin/node dist/db/migrate-cli.js
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# Resource limits for a small VPS. Raise MemoryMax if the monitor reports the API near it.
MemoryMax=1G
TasksMax=256
LimitNOFILE=8192

# Hardening: the API needs to read its release folder and write only its own state folder.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/stslv-amc
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
