# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stslv_amc_dev
DB_USER=postgres
DB_PASSWORD=

# Authentication
# Long random value (at least 32 characters) used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid: a number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# Web origins allowed to call the API from a browser (comma-separated).
CORS_ORIGIN=http://localhost:5173
