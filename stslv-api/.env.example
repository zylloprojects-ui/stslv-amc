# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stslv_amc_dev
DB_USER=postgres
DB_PASSWORD=

# Authentication
# Long random value (at least 32 characters) used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid: a number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# Web origins allowed to call the API from a browser (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Sign up and password recovery
# Forgotten passwords are recovered by an administrator, who issues a temporary
# password in Users & Access (15 minutes, fixed). No email is involved.
# Web address of the application.
# Defaults to the first CORS_ORIGIN.
APP_URL=http://localhost:5173
# How outgoing email is handled (only the notice to the owner of an existing
# account when someone signs up with their address):
#   none  nothing is sent (default).
#   log   LOCAL DEVELOPMENT ONLY: the whole message is printed to the API
#         console. The API refuses to start with this value when NODE_ENV=production.
MAIL_TRANSPORT=none
# Requests one network address may make to the public sign-up route per 15 minutes.
PUBLIC_AUTH_RATE_LIMIT=10
# Temporary passwords one administrator may issue per 15 minutes.
TEMPORARY_PASSWORD_RATE_LIMIT=10
# Sign-in requests one network address may make per 15 minutes (successful or not).
LOGIN_RATE_LIMIT=50
# Failed sign-ins allowed per 15 minutes for one email from one network address.
LOGIN_FAILURE_LIMIT=5

# Hosting only. Set to "require" when the database only accepts encrypted
# connections (for example Neon). Read by the PostgreSQL driver itself.
# Leave unset for the local database, which does not use TLS.
# PGSSLMODE=require

# Hosting only. Number of reverse proxies in front of the API (0 to 10).
# Leave at 0 for local development. See docs/DEPLOYMENT.md.
TRUST_PROXY=0

# Document storage (contract documents, service reports, quotations, receipts).
# Choose ONE of (more than one, or a partial set, stops the API from starting):
#  a) A private Supabase Storage bucket through its S3 endpoint (production). Set all five.
#     From Supabase: Project Settings > Storage > S3 Connection. The keys are server-side only:
#     they reach every bucket of the project and bypass RLS. Never commit real values.
# SUPABASE_PROJECT_REF=
# SUPABASE_S3_REGION=
# SUPABASE_S3_BUCKET=
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
#     The Endpoint exactly as shown on Storage > S3 Connection. Optional (default
#     https://<project ref>.storage.supabase.co/storage/v1/s3). Production sets it to the
#     dashboard's Endpoint (the real bucket check passed with it, 2026-11-04).
# SUPABASE_S3_ENDPOINT=
#  a2) Or a private Cloudflare R2 bucket. Set all four.
#     The token needs "Object Read & Write" on this one bucket only. Never commit real values.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#     Only for a bucket created in a jurisdiction (e.g. EU): https://<account id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=
#  b) Or a local folder. Local development defaults to stslv-api/storage/attachments.
#     In production there is no default: without R2 or this, uploads stay switched off.
# ATTACHMENTS_DIR=
# Check the configured storage end to end with: npm run storage:check
# Largest file accepted, in MB (1 to 50).
ATTACHMENT_MAX_MB=12

# Manual backups (Backup & Restore page). Off unless BACKUP_DIR is set. In production the folder
# must be durable and declared so: a hosting disk that is lost on restart does not qualify.
# BACKUP_DIR=
# BACKUP_STORAGE_DURABLE=false
# PG_DUMP_PATH=pg_dump
# PG_RESTORE_PATH=pg_restore

# Business rules approved 2026-11-09, but OFF until the approved production release (docs/P1_FIXES.md).
# AMC_CONTRACT_EXPIRY_ENABLED allows `contracts:expire --apply`: set it only in the scheduled job's own
# environment, never for the web server (docs/CONTRACT_EXPIRY.md). SERVICE_REPORT_NO_LOCK_ENABLED locks
# the Service Report No. of Paid services (docs/SERVICE_REPORT_COMPLETION_LOCK.md). Only "true" enables.
# AMC_CONTRACT_EXPIRY_ENABLED=false
# SERVICE_REPORT_NO_LOCK_ENABLED=false
