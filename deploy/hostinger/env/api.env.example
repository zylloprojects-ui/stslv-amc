# STSLV AMC API — production settings for the Hostinger VPS. TEMPLATE: copy to /etc/stslv-amc/api.env
# (owner root, group stslv, mode 0640) and fill in. NEVER commit the filled-in file.
# Every variable is explained in stslv-api/.env.example; only VPS-specific values are noted here.

NODE_ENV=production
PORT=3001

# Neon PostgreSQL (retained initially). The DIRECT host, not the "-pooler" one: migrations hold a session lock.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
PGSSLMODE=verify-full

# Long random value, at least 32 characters, NEW for this server (do not reuse Render's):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Sign-out after this many minutes without use (5 to 1440). P0 requirement: 30.
SESSION_IDLE_TIMEOUT_MINUTES=30

# The web application is served by Nginx on the same host name, so the browser's origin is:
CORS_ORIGIN=https://__APP_DOMAIN__
APP_URL=https://__APP_DOMAIN__

# Exactly one proxy (Nginx) stands in front of the API.
TRUST_PROXY=1

MAIL_TRANSPORT=none
LOGIN_RATE_LIMIT=50
LOGIN_FAILURE_LIMIT=5
PUBLIC_AUTH_RATE_LIMIT=10
TEMPORARY_PASSWORD_RATE_LIMIT=10
BCRYPT_ROUNDS=12

# Supabase Storage (retained initially): the same five values as on Render today, plus the endpoint.
SUPABASE_PROJECT_REF=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=
ATTACHMENT_MAX_MB=12

# In-app manual backups stay OFF on the VPS: scheduled backups are done by the stslv-amc-db-backup timer
# (docs/BACKUP_AUTOMATION.md), which keeps backup credentials away from the API.
# BACKUP_DIR=

# Business rules approved 2026-11-09 (docs/P1_FIXES.md) but OFF until a separately approved production release.
# Only the exact value "true" switches either on. Added at the final integration.
#   SERVICE_REPORT_NO_LOCK_ENABLED: locks the Service Report No. of Paid services (Admin / Super Admin override
#   with a reason, audited). Belongs here, in the API's environment; restart the API to apply.
# SERVICE_REPORT_NO_LOCK_ENABLED=false
#   AMC_CONTRACT_EXPIRY_ENABLED must NEVER be set for the web API: it belongs only to the scheduled expiry job's
#   own environment (no timer for it is installed yet; docs/CONTRACT_EXPIRY.md).
