# Local development needs no .env file: Vite forwards /api to the API on
# http://localhost:3001 (see vite.config.ts).

# Hosted builds only (set in the Cloudflare Pages project, not in a file).
# Address of the API, without a trailing slash and without /api.
# VITE_API_BASE_URL=https://your-api-host.example.com

# Local development only. Where the Vite dev server forwards /api.
# VITE_API_PROXY_TARGET=http://localhost:3001
