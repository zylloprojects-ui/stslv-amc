# Copy this file to .env and fill in the values. Never commit .env.

PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stslv_amc_dev
DB_USER=postgres
DB_PASSWORD=

# Authentication
# Long random value (at least 32 characters) used to sign login tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a login stays valid: a number followed by s, m, h or d.
JWT_EXPIRES_IN=8h

# Web origins allowed to call the API from a browser (comma-separated).
CORS_ORIGIN=http://localhost:5173

# Sign up and password recovery
# Forgotten passwords are recovered by an administrator, who issues a temporary
# password in Users & Access (15 minutes, fixed). No email is involved.
# Web address of the application.
# Defaults to the first CORS_ORIGIN.
APP_URL=http://localhost:5173
# How outgoing email is handled (only the notice to the owner of an existing
# account when someone signs up with their address):
#   none  nothing is sent (default).
#   log   LOCAL DEVELOPMENT ONLY: the whole message is printed to the API
#         console. The API refuses to start with this value when NODE_ENV=production.
MAIL_TRANSPORT=none
# Requests one network address may make to the public sign-up route per 15 minutes.
PUBLIC_AUTH_RATE_LIMIT=10
# Temporary passwords one administrator may issue per 15 minutes.
TEMPORARY_PASSWORD_RATE_LIMIT=10
# Sign-in requests one network address may make per 15 minutes (successful or not).
LOGIN_RATE_LIMIT=50
# Failed sign-ins allowed per 15 minutes for one email from one network address.
LOGIN_FAILURE_LIMIT=5

# Hosting only. Set to "require" when the database only accepts encrypted
# connections (for example Neon). Read by the PostgreSQL driver itself.
# Leave unset for the local database, which does not use TLS.
# PGSSLMODE=require

# Hosting only. Number of reverse proxies in front of the API (0 to 10).
# Leave at 0 for local development. See docs/DEPLOYMENT.md.
TRUST_PROXY=0

# Attachments (contract documents, quotations, receipts).
# Folder where uploaded files are kept. Local development defaults to
# stslv-api/storage/attachments. In production there is no default: leave it
# unset until durable storage is approved, and uploads stay switched off.
# ATTACHMENTS_DIR=
# Largest file accepted, in MB (1 to 50).
ATTACHMENT_MAX_MB=10
