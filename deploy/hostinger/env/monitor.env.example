# STSLV AMC monitor — settings. TEMPLATE: copy to /etc/stslv-amc/monitor.env (root:stslv-monitor 0640).
# Read by /usr/local/lib/stslv-amc/monitor.sh every 5 minutes (stslv-amc-monitor.timer).

MONITOR_ENVIRONMENT=production
MONITOR_ALERT_WEBHOOK_URL=
# A separate dead-man's switch for the server itself (pinged every 5 minutes while all is well).
MONITOR_HEARTBEAT_URL=
MONITOR_PUBLIC_URL=https://__APP_DOMAIN__
MONITOR_API_URL=http://127.0.0.1:3001
MONITOR_DISK_PATHS=/
MONITOR_DISK_WARN_PERCENT=80
MONITOR_MEM_MIN_AVAILABLE_PERCENT=10
MONITOR_CERT_MIN_DAYS=14
MONITOR_BACKUP_STATE_DIR=/var/lib/stslv-amc-backup/state
MONITOR_BACKUP_MAX_AGE_HOURS=26
MONITOR_REPEAT_MINUTES=360
MONITOR_STATE_DIR=/var/lib/stslv-amc-monitor
